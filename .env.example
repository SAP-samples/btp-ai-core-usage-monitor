# ============================================================
# AI Core Capacity Monitor – Environment Variables
# ============================================================
# Copy this file to .env for local development:
#   cp .env.example .env
# Then fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ── BTP Subaccount ────────────────────────────────────────────
# The UUID of the subaccount to monitor (from BTP cockpit URL)
SUBACCOUNT_ID=<your-subaccount-uuid>

# ── Spending limit & alert thresholds ─────────────────────────
# Monthly AI Core capacity unit budget
SPENDING_LIMIT=100

# Send a WARNING email when usage reaches this % of the limit
WARNING_THRESHOLD_PERCENT=60

# Send an ALERT email when usage reaches this % of the limit
ALERT_THRESHOLD_PERCENT=80

# ── Notification settings ─────────────────────────────────────
# Send a daily summary email even when below warning threshold
RECEIVE_DAILY_UPDATE_EMAILS=true

# Comma-separated list of recipient email addresses
NOTIFICATION_EMAIL=admin@example.com,team@example.com

# Display name shown in the From field of notification emails
SENDER_NAME=AI Core Consumption Monitor

# ── Scheduler ─────────────────────────────────────────────────
# Time of day (UTC) to run the daily check  (HH:MM format)
CHECK_TIME_UTC=07:00

# ── UAS Reporting API ─────────────────────────────────────────
# OAuth2 credentials for the UAS Reporting API.
# How to obtain:
#   1. In BTP cockpit → your subaccount → Services → Instances
#   2. Find or create a "Usage Data Management" service instance (plan: reporting-ga-admin)
#   3. Create a service key → copy clientid, clientsecret, url (token URL)
UAS_CLIENT_ID=sb-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx!bXXXXX|uas-reporting!bXXX
UAS_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The 'url' field from the UAS service key (XSUAA authentication endpoint).
# The region in this URL is used to auto-derive UAS_REPORTING_BASE_URL.
UAS_TOKEN_URL=https://<global-account-id>.authentication.<region>.hana.ondemand.com

# OPTIONAL: Override the reporting API base URL if auto-detection does not work.
# Auto-detected from UAS_TOKEN_URL as: https://uas-reporting.cfapps.<region>.hana.ondemand.com
# UAS_REPORTING_BASE_URL=https://uas-reporting.cfapps.<region>.hana.ondemand.com

# ── SMTP email ────────────────────────────────────────────────
# Enable/disable SMTP email notifications
ENABLE_SMTP=true

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=monitor@yourcompany.com
SMTP_PASSWORD=your-smtp-app-password
# Sender address in the From header. Defaults to SMTP_USER if not set.
# Set this if your SMTP server requires a specific authorized sender address.
SMTP_FROM=monitor@yourcompany.com
SMTP_USE_TLS=true

# ── SAP Alert Notification Service (ANS) ─────────────────────
# Enable/disable ANS notifications (in addition to or instead of SMTP)
ENABLE_ANS=false

# Option A: Use a CF service binding (recommended on BTP)
#   Create an alert-notification service instance named as below,
#   then add it to the `services:` section in manifest.yml
ANS_SERVICE_NAME=ai-core-monitor-ans

# Option B: Provide credentials directly (for local testing)
ANS_URL=https://clm-sl-ans-live-ans-service-api.cfapps.<suffix>.hana.ondemand.com
ANS_CLIENT_ID=sb-xxxxxxxx!bXXXX|ans-xsuaa!bXXX
ANS_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANS_TOKEN_URL=https://your-subaccount.authentication.<suffix>.hana.ondemand.com